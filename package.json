{
  "name": "connect-plus",
  "private": true,
  "description": "Connect+ — site estático; este arquivo existe só para os testes.",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integracao/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:int": "node --test \"tests/integracao/**/*.test.js\"",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-include=\"js/**\" \"tests/unit/**/*.test.js\" \"tests/integracao/**/*.test.js\"",
    "test:e2e": "playwright test",
    "serve": "python3 -m http.server 8080",
    "test:cov:ui": "node tests/apoio/cobertura-ui.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "jsdom": "^31.0.0"
  }
}
